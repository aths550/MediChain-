{
  "name": "medichain",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "contracts",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c cyan,magenta \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "test": "npm run test --workspace=contracts",
    "build": "npm run build --workspace=frontend",
    "seed": "npm run seed --workspace=contracts",
    "check-network": "npm run check-network --workspace=contracts",
    "smoke": "npm run smoke --workspace=contracts"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
