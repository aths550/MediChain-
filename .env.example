# ─── Contracts ────────────────────────────────────────────────────────────────
# Private key of the deployer wallet (fund from faucet: https://faucet.mstblockchain.com/)
PRIVATE_KEY=0xyour_deployer_private_key_here

# MST Testnet RPC
MST_RPC_URL=https://testnetrpc.mstblockchain.com

# ─── Backend ──────────────────────────────────────────────────────────────────
# Secret for HMAC-SHA256 QR code signatures (generate: openssl rand -hex 32)
QR_SECRET=9e7876d86d635fc71b5e272f778e9f52de2f28d2911bb02ea971bf9bf0a79fea

# Base URL of the deployed frontend (Vercel URL or http://192.168.x.x:5173 for LAN testing)
# IMPORTANT: Set this to your Vercel URL BEFORE generating demo QRs!
# For local phone testing over Wi-Fi, use your machine's LAN IP:
#   FRONTEND_URL=http://192.168.1.42:5173
FRONTEND_URL=http://localhost:5173

# Port for the backend server
PORT=3001

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Backend API base URL
VITE_API_URL=http://localhost:3001

# Contract address (written automatically by deploy.js — but can be overridden)
# VITE_CONTRACT_ADDRESS=0x...

# MST Testnet chain config (for MetaMask auto-add)
VITE_CHAIN_ID=91562037
VITE_RPC_URL=https://testnetrpc.mstblockchain.com
VITE_EXPLORER_URL=https://testnet.mstscan.com
